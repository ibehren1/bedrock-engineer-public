{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@/*": ["src/*"],
      "@common/*": ["src/common/*"]
    }
  },
  "include": ["src/**/*.test.ts", "src/**/*.integration.test.ts"]
}
